# Copy this file to .env and adjust values for your environment.
# For quick local testing, these defaults are intentionally runnable.

COMPOSE_PROJECT_NAME=hlstatsx-community-edition

# Database credentials
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=hlstatsxce
MYSQL_USER=hlstatsxce
MYSQL_PASSWORD=hlstatsxce
MYSQL_IMAGE_TAG=5.7

# HLstats daemon/web DB connection values
HLX_DB_NAME=hlstatsxce
HLX_DB_USER=hlstatsxce
HLX_DB_PASS=hlstatsxce

# Exposed ports
HLX_UDP_PORT=27500
HLX_WEB_PORT=8081
HLX_PMA_PORT=8083

# Domains for traefik labels in docker-compose.example.yml
HLX_WEB_DOMAIN=web.example.com
HLX_PMA_DOMAIN=phpmyadmin.example.com
HLX_ACME_EMAIL=postmaster@example.com

# Prebuilt image source for docker-compose.example.yml
# Override these if publishing/consuming your own forked images.
HLX_IMAGE_REPO=startersclan/hlstatsx-community-edition
HLX_IMAGE_TAG=1.11.6

# Dockge template values (compose.dockge.example.yaml)
HLX_SOURCE_DIR=.
DB_VOLUME_NAME=hlstatsx_db-volume
